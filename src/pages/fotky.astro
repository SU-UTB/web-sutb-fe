---
import Layout from '../components/Layout.astro';
import Container from '../components/atoms/Container.astro';
import H1 from '../components/atoms/H1.astro';
import Breadcrumbs from '../components/organisms/Breadcrumbs.astro';

const metaTags = {
  title: 'Galerie | Studentská unie UTB',
  description: 'Prohlédněte si fotogalerie z našich uplynulých projektů a akcí.',
  image: '/meta-image-galerie.jpg',
};
---

<Layout {...metaTags}>
  <section class="pt-8 sm:pt-10 lg:pt-12 pb-16 bg-gradient-to-b from-white via-stone-100 to-stone-100 min-h-screen">
    <Container>
      <Breadcrumbs
        items={[
          {
            title: 'Galerie',
            href: '/galerie',
          },
        ]}
      />
      <H1>Galerie</H1>
      <p class="sm:text-lg lg:text-xl pt-6 pb-10 text-stone-700 tracking-wide leading-relaxed sm:leading-relaxed lg:leading-relaxed max-w-3xl">
        Zavzpomínej s námi na uplynulé ročníky našich projektů. Vyber si rok, klikni na složku projektu a prohlédni si všechna alba plná vzpomínek.
      </p>

      <!-- Dynamicky plněný kontejner galerií -->
      <div id="gallery-container" class="space-y-6">
        <div class="text-center py-12 text-stone-500">Načítám galerii...</div>
      </div>
    </Container>
  </section>

  <!-- Dynamicky plněný kontejner modálních oken -->
  <div id="modals-container"></div>
</Layout>

<script>
  interface Album {
    title: string;
    image: string;
    link: string;
  }

  interface Project {
    id: string;
    name: string;
    albums: Album[];
  }

  interface YearGroup {
    year: string;
    projects: Project[];
  }

  const getAlbumWord = (count: number) => {
    if (count === 1) return 'album';
    if (count >= 2 && count <= 4) return 'alba';
    return 'alb';
  };

  const getModalMaxWidth = (count: number) => {
    if (count <= 2) return 'max-w-3xl';
    if (count === 3) return 'max-w-4xl';
    return 'max-w-5xl';
  };

  const getGridCols = (count: number) => {
    if (count <= 2) return 'grid-cols-1 sm:grid-cols-2';
    if (count === 3) return 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3';
    return 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4';
  };

  const getImagePath = (year: string, fileName: string) => {
    return `/gallery_previews/${year}/${fileName}`;
  };

  document.addEventListener('astro:page-load', loadGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadGallery);
  } else {
    loadGallery();
  }

  async function loadGallery() {
    const container = document.getElementById('gallery-container');
    const modalsContainer = document.getElementById('modals-container');

    if (!container || !modalsContainer) return;

    try {
      // načtení JSONu ze složky public/
      const response = await fetch('/gallery.json', { cache: 'no-cache' });
      if (!response.ok) throw new Error('Failed to fetch gallery data');
      
      const galleryData: YearGroup[] = await response.json();

      container.innerHTML = '';
      modalsContainer.innerHTML = '';

      // 1. Vygenerování let a projektů
      galleryData.forEach((yearGroup, index) => {
        const details = document.createElement('details');
        details.className = 'group bg-white rounded-2xl shadow-sm border border-stone-200 overflow-hidden';
        if (index === 0) details.open = true;

        let projectsHTML = '';

        yearGroup.projects.forEach((project) => {
          const isSingleAlbum = project.albums.length === 1;

          if (isSingleAlbum) {
            const album = project.albums[0];
            projectsHTML += `
              <a 
                href="${album.link}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex flex-col items-center group/album text-left w-full focus:outline-none"
                aria-label="Otevřít album ${project.name}"
              >
                <div class="w-full relative transition-transform duration-300 group-hover/album:-translate-y-2 group-hover/album:drop-shadow-lg">
                  <div class="w-full h-4"></div>
                  <div class="w-full aspect-square bg-stone-100 rounded-2xl p-2 shadow-md overflow-hidden relative border border-stone-200/60">
                    <div class="w-full h-full rounded-lg overflow-hidden relative">
                      <img 
                        src="${getImagePath(yearGroup.year, album.image)}" 
                        alt="${album.title}" 
                        class="w-full h-full object-cover group-hover/album:scale-105 transition-all duration-500"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent pointer-events-none"></div>
                      <div class="absolute top-3 right-3 bg-white/90 backdrop-blur text-stone-800 p-1.5 rounded-full opacity-0 group-hover/album:opacity-100 transition-opacity shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>
                <span class="mt-3 font-semibold text-stone-800 text-center w-full truncate px-1 group-hover/album:text-orange-600 transition-colors">
                  ${project.name}
                </span>
                <span class="text-sm text-stone-500">${project.albums.length}&nbsp;${getAlbumWord(project.albums.length)}</span>
              </a>
            `;
          } else {
            // MULTIPLE ALBUMS FOLDER
            let previewImagesHTML = '';
            const sliceAlbums = project.albums.slice(0, 4);

            sliceAlbums.forEach((album) => {
              previewImagesHTML += `
                <div class="w-full h-full bg-orange-200 rounded-lg overflow-hidden">
                  <img 
                    src="${getImagePath(yearGroup.year, album.image)}" 
                    alt="Náhled ${album.title}" 
                    class="w-full h-full object-cover transition-opacity"
                    loading="lazy"
                  />
                </div>
              `;
            });

            const missingCount = Math.max(0, 4 - project.albums.length);
            for (let i = 0; i < missingCount; i++) {
              previewImagesHTML += `<div class="w-full h-full bg-orange-200/50 rounded-lg"></div>`;
            }

            projectsHTML += `
              <button 
                class="folder-btn flex flex-col items-center group/folder text-left w-full focus:outline-none"
                data-modal-target="modal-${project.id}"
                aria-label="Otevřít galerii projektu ${project.name}"
              >
                <div class="w-full relative transition-transform duration-300 group-hover/folder:-translate-y-2 group-hover/folder:drop-shadow-lg">
                  <div class="w-1/3 h-4 bg-orange-400 rounded-t-lg ml-3 shadow-inner"></div>
                  <div class="w-full aspect-square bg-orange-300 rounded-2xl rounded-tl-none p-2 grid grid-cols-2 grid-rows-2 gap-2 shadow-md overflow-hidden relative border-t border-white/20">
                    ${previewImagesHTML}
                    <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-white/20 pointer-events-none"></div>
                  </div>
                </div>
                <span class="mt-3 font-semibold text-stone-800 text-center w-full truncate px-1 group-hover/folder:text-orange-600 transition-colors">
                  ${project.name}
                </span>
                <span class="text-sm text-stone-500">${project.albums.length}&nbsp;${getAlbumWord(project.albums.length)}</span>
              </button>
            `;
          }
        });

        details.innerHTML = `
          <summary class="flex justify-between items-center cursor-pointer p-6 sm:p-8 font-semibold text-2xl text-stone-800 hover:bg-stone-50 transition-colors list-none">
            <span>Rok ${yearGroup.year}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-stone-400 group-open:-rotate-180 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="p-6 sm:p-8 pt-0 bg-white">
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8">
              ${projectsHTML}
            </div>
          </div>
        `;

        container.appendChild(details);

        // 2. Vygenerování modálních oken pro projekty s >1 albem
        yearGroup.projects
          .filter((p) => p.albums.length > 1)
          .forEach((project) => {
            const modal = document.createElement('div');
            modal.id = `modal-${project.id}`;
            modal.className = 'fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 ease-out';
            modal.setAttribute('role', 'dialog');
            modal.setAttribute('aria-modal', 'true');

            let gridAlbumsHTML = '';
            project.albums.forEach((album) => {
              gridAlbumsHTML += `
                <a 
                  href="${album.link}" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="group/modal flex flex-col bg-stone-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-stone-100 hover:-translate-y-1 focus:outline-none focus:ring-4 focus:ring-orange-300"
                >
                  <div class="aspect-[4/3] w-full overflow-hidden relative">
                    <img 
                      src="${getImagePath(yearGroup.year, album.image)}" 
                      alt="${album.title}" 
                      class="w-full h-full object-cover group-hover/modal:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur text-stone-800 p-1.5 rounded-full opacity-0 group-hover/modal:opacity-100 transition-opacity shadow-sm">
                       <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </div>
                  </div>
                  <div class="p-4 bg-white flex-1 flex items-center justify-center">
                    <h3 class="font-bold text-stone-800 text-center line-clamp-2">${album.title}</h3>
                  </div>
                </a>
              `;
            });

            modal.innerHTML = `
              <div class="absolute inset-0 bg-stone-900/60 backdrop-blur-sm modal-backdrop transition-opacity"></div>
              <div class="relative bg-white rounded-3xl w-full ${getModalMaxWidth(project.albums.length)} max-h-[90vh] flex flex-col shadow-2xl transform scale-95 transition-transform duration-300 ease-out modal-content">
                <div class="flex justify-between items-center p-6 sm:px-8 border-b border-stone-100 shrink-0">
                  <div>
                    <p class="text-sm font-semibold tracking-wider text-orange-500 uppercase mb-1">Rok ${yearGroup.year}</p>
                    <h2 class="text-2xl sm:text-3xl font-bold text-stone-800">${project.name}</h2>
                  </div>
                  <button class="modal-close p-2 text-stone-400 hover:text-stone-800 hover:bg-stone-100 rounded-full transition-colors focus:outline-none" aria-label="Zavřít galerii">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
                <div class="p-6 sm:p-8 overflow-y-auto custom-scrollbar">
                  <div class="grid ${getGridCols(project.albums.length)} gap-6">
                    ${gridAlbumsHTML}
                  </div>
                </div>
              </div>
            `;

            modalsContainer.appendChild(modal);
          });
      });

      // Inicializace posluchačů událostí pro modální okna
      initModals();
    } catch (error) {
      console.error('Chyba při načítání galerie:', error);
      container.innerHTML = '<div class="text-center py-12 text-red-500">Nepodařilo se načíst data galerie.</div>';
    }
  }

  function initModals() {
    const folderButtons = document.querySelectorAll('.folder-btn');
    const closeButtons = document.querySelectorAll('.modal-close');
    const backdrops = document.querySelectorAll('.modal-backdrop');
    
    let activeModal: HTMLElement | null = null;

    function openModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      
      document.body.style.overflow = 'hidden';
      activeModal = modal;
      
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const content = modal.querySelector('.modal-content');
        if (content) {
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        }
      });
    }

    function closeModal() {
      if (!activeModal) return;
      
      activeModal.classList.add('opacity-0', 'pointer-events-none');
      const content = activeModal.querySelector('.modal-content');
      if (content) {
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
      }
      
      setTimeout(() => {
        if(activeModal) {
          activeModal.classList.remove('flex');
          activeModal.classList.add('hidden');
        }
        document.body.style.overflow = '';
        activeModal = null;
      }, 300);
    }

    folderButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-modal-target');
        if (targetId) openModal(targetId);
      });
    });

    closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
    backdrops.forEach(backdrop => backdrop.addEventListener('click', closeModal));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeModal) {
        closeModal();
      }
    });
  }
</script>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #e7e5e4;
    border-radius: 20px;
    border: 3px solid white;
  }
</style>